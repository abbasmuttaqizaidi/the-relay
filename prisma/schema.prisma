// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// 1. MODELS DEFINITIONS
// ---------------------------------------------------------

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerk_user_id String   @unique
  email         String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  businesses          Business[]
  business_members    BusinessMember[]
  saved_opportunities SavedOpportunity[]
  notifications       Notification[]

  @@map("users")
}

model Business {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_user_id           String    @db.Uuid
  company_name            String
  website                 String
  industry                String
  description             String?
  linkedin_url            String?
  logo_url                String?
  hq_location             String?
  founded_year            Int?
  company_size            String?
  company_type            String?
  funding_stage           String?
  twitter_url             String?
  contact_email           String?
  status                  String    @default("pending")
  website_verified        Boolean   @default(false)
  website_verified_at     DateTime? @db.Timestamptz(6)
  website_verified_domain String?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  owner            User             @relation(fields: [owner_user_id], references: [id], onDelete: Cascade)
  members          BusinessMember[]
  opportunities    Opportunity[]
  interests        Interest[]

  @@map("businesses")
}

model BusinessMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String   @db.Uuid
  user_id     String   @db.Uuid
  role        String   @default("member")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([business_id, user_id])
  @@map("business_members")
}

model Opportunity {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id        String    @db.Uuid
  opportunity_number String    @unique
  title              String
  description        String
  category           String
  industry           String    @default("SaaS")
  location           String?
  offer_text         String?
  status             String    @default("active")
  hide_company_name  Boolean   @default(false)
  promotion_status   String    @default("none")
  expires_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  business       Business           @relation(fields: [business_id], references: [id], onDelete: Cascade)
  interests      Interest[]
  saved_by_users SavedOpportunity[]

  @@index([business_id])
  @@index([category])
  @@index([status])
  @@index([created_at])
  @@index([promotion_status])
  @@map("opportunities")
}

model Interest {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id         String      @db.Uuid
  requesting_business_id String      @db.Uuid
  message                String?
  status                 String      @default("pending")
  created_at             DateTime    @default(now()) @db.Timestamptz(6)
  updated_at             DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  opportunity         Opportunity @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)
  requesting_business Business    @relation(fields: [requesting_business_id], references: [id], onDelete: Cascade)

  @@unique([opportunity_id, requesting_business_id])
  @@index([opportunity_id])
  @@index([requesting_business_id])
  @@index([status])
  @@map("interests")
}

model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action     String
  details    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("activity_logs")
}


model SavedOpportunity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  opportunity_id String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)

  @@unique([user_id, opportunity_id])
  @@index([user_id], map: "idx_saved_opportunities_user")
  @@index([opportunity_id], map: "idx_saved_opportunities_opportunity")
  @@index([created_at], map: "idx_saved_opportunities_created_at")
  @@map("saved_opportunities")
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  title       String
  description String?
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}
